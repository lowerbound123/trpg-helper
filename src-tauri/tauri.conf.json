{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TRPG Helper",
  "version": "1.0.0",
  "identifier": "com.tonychow.trpghelper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm prepare:segmentation-resources && pnpm dev",
    "beforeBuildCommand": "pnpm prepare:segmentation-resources && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "TRPG Helper",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/onnxruntime/**/*"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
